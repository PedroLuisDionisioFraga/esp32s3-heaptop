# Reduce bootloader log verbosity
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2

# Increase main task stack size (the console loop runs heaptop commands)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168

# Keep console history in RAM only. Saving it to flash after every command (the
# IDF console example's default) stalls the other core in ipc1 on each write,
# which heaptop shows as 25-50% CPU on core 1 -- noise in a heaptop demo.
# CONFIG_CONSOLE_STORE_HISTORY is not set

# Partition table with a FAT partition, in case history storage is turned back on
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_example.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_example.csv"

# FreeRTOS task stats: uxTaskGetSystemState, per-task CPU % (64-bit esp_timer counters), core id
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Per-task heap and leak suspicion (debug builds only: task tracking slows the allocator)
CONFIG_HEAP_TASK_TRACKING=y
CONFIG_HEAP_TRACK_DELETED_TASKS=y
CONFIG_HEAP_POISONING_LIGHT=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console on UART0 (USB-UART bridge); no secondary console, it is output-only
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
